{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build:site": "next build --turbopack",
    "build:pdf": "node scripts/generate-pdf.mjs",
    "build": "pnpm build:site && pnpm build:pdf",
    "start": "next start",
    "lint": "biome check",
